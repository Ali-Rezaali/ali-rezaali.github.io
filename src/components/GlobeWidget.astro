---
---

<div class="relative w-full h-[450px] sm:h-[520px] rounded-3xl overflow-hidden border border-slate-800 bg-black flex items-center justify-center mb-10 shadow-2xl group">
  
  <!-- #81C433 Ambient Glow -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#81C433]/10 via-transparent to-black pointer-events-none z-10"></div>

  <!-- 3D WebGL Globe Canvas -->
  <canvas
    id="cobe-globe"
    class="w-[500px] h-[500px] max-w-full opacity-90 cursor-grab active:cursor-grabbing z-0"
    style="width: 500px; height: 500px;"
  ></canvas>

  <!-- Live Telemetry Overlay -->
  <div class="absolute bottom-6 left-6 z-20 flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-black/80 border border-slate-800 text-xs font-mono text-slate-300 backdrop-blur-md shadow-lg">
    <span class="w-2 h-2 rounded-full bg-[#81C433] animate-ping"></span>
    <span id="globe-status-text">SATELLITE GROUND STATIONS (ORBITAL)</span>
  </div>

  <div class="absolute top-6 right-6 z-20 hidden sm:flex text-[10px] font-mono text-slate-500 flex-col items-end gap-1">
    <span>ALT: 705 KM</span>
    <span>INC: 98.2° (SUN-SYNCHRONOUS)</span>
  </div>
</div>

<!-- Load COBE WebGL via CDN -->
<script is:inline src="https://cdn.jsdelivr.net/npm/cobe"></script>
<script is:inline>
  (() => {
    let phi = 0;
    let globeInstance = null;
    const canvas = document.getElementById('cobe-globe');
    const statusText = document.getElementById('globe-status-text');
    
    if (!canvas) return;

    const defaultMarkers = [
      { location: [52.3676, 4.9041], size: 0.08 },
      { location: [78.2232, 15.6267], size: 0.09 },
      { location: [37.7749, -122.4194], size: 0.06 },
      { location: [-33.8688, 151.2093], size: 0.05 },
      { location: [1.3521, 103.8198], size: 0.05 },
    ];

    function initGlobe(markers) {
      if (globeInstance) globeInstance.destroy();

      const width = 500;
      globeInstance = createGlobe(canvas, {
        devicePixelRatio: Math.min(window.devicePixelRatio || 1, 2),
        width: width * 2,
        height: width * 2,
        phi: 0,
        theta: 0.25,
        dark: 1,
        diffuse: 1.4,
        mapSamples: 20000,
        mapBrightness: 5,
        baseColor: [0.02, 0.03, 0.02],
        markerColor: [0.505, 0.768, 0.2], // #81C433 Accent
        glowColor: [0.15, 0.3, 0.1],
        markers: markers,
        onRender: (state) => {
          state.phi = phi;
          phi += 0.003;
        }
      });
    }

    // 1. Render immediate default globe so canvas is never blank
    initGlobe(defaultMarkers);

    // 2. Safely attempt to fetch and parse Kepler JSON in background
    fetch('/kepler.gl.json')
      .then((res) => (res.ok ? res.json() : Promise.reject('File not found')))
      .then((keplerData) => {
        const extractedMarkers = [];

        const datasets = keplerData.datasets || keplerData.config?.visState?.datasets || [];
        if (Array.isArray(datasets) && datasets.length > 0) {
          datasets.forEach((ds) => {
            const dataObj = ds.data || ds;
            const fields = dataObj.fields || [];
            const rows = dataObj.rows || dataObj.allData || [];

            const latIdx = fields.findIndex((f) => /lat|latitude/i.test(typeof f === 'string' ? f : f.name));
            const lngIdx = fields.findIndex((f) => /lng|lon|longitude/i.test(typeof f === 'string' ? f : f.name));

            if (latIdx !== -1 && lngIdx !== -1) {
              rows.forEach((r) => {
                const lat = parseFloat(r[latIdx]);
                const lng = parseFloat(r[lngIdx]);
                if (!isNaN(lat) && !isNaN(lng)) {
                  extractedMarkers.push({ location: [lat, lng], size: 0.05 });
                }
              });
            }
          });
        } else if (keplerData.features) {
          keplerData.features.forEach((f) => {
            if (f.geometry && f.geometry.type === 'Point') {
              const [lng, lat] = f.geometry.coordinates;
              extractedMarkers.push({ location: [lat, lng], size: 0.05 });
            }
          });
        }

        if (extractedMarkers.length > 0) {
          initGlobe(extractedMarkers);
          if (statusText) statusText.textContent = `KEPLER NODES: ${extractedMarkers.length} ACTIVE`;
        }
      })
      .catch(() => {
        // Fallback is already actively rendering, no action needed
      });
  })();
</script>