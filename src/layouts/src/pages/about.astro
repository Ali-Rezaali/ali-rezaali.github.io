---
import BaseLayout from '../layouts/BaseLayout.astro';

// Technical Stack Data
const technicalSkills = [
  {
    category: "GIS & Earth Observation",
    color: "emerald",
    items: ["QGIS", "ArcGIS Pro", "Google Earth Engine", "SNAP", "PostGIS", "GDAL/OGR"]
  },
  {
    category: "Spatial Data Science & ML",
    color: "cyan",
    items: ["Python", "GeoPandas", "Rasterio", "Xarray", "PyTorch", "R / Spatial"]
  },
  {
    category: "Satellite Imagery & Sensors",
    color: "emerald",
    items: ["Sentinel-1 (SAR)", "Sentinel-2 (MSI)", "Landsat 8/9", "MODIS", "ICESat-2", "LiDAR Point Clouds"]
  },
  {
    category: "Web GIS & Development",
    color: "cyan",
    items: ["Leaflet.js", "Mapbox GL JS", "Astro", "Tailwind CSS", "Docker", "Git / GitHub"]
  }
];

// Timeline Data
const timeline = [
  {
    date: "2024 — Present",
    title: "MSc in GIS & Remote Sensing",
    institution: "University Department",
    description: "Specializing in satellite time-series analysis, deep learning for feature extraction, and radar (SAR) applications for land monitoring.",
    badge: "Academic"
  },
  {
    date: "2025 — 2026",
    title: "Geospatial Data Research Assistant",
    institution: "Earth Observation Lab",
    description: "Processed terabyte-scale satellite archives using Google Earth Engine and Python pipelines to map land cover dynamics.",
    badge: "Research"
  },
  {
    date: "2020 — 2024",
    title: "BSc in Geomatics / Geography",
    institution: "University",
    description: "Graduated with honors. Thesis focused on spatial statistics and satellite-derived vegetation indices.",
    badge: "Education"
  }
];
---

<BaseLayout title="About | Ali Rezaali">
  <main class="max-w-5xl mx-auto px-4 py-8 space-y-16">
    
    <!-- 1. HERO & BIO SECTION -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Bio Text -->
      <div class="lg:col-span-8 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>MSc GIS & Remote Sensing Specialist</span>
        </div>

        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">
          Bridging Earth Observation, Spatial Data Science, & Code.
        </h1>

        <p class="text-slate-300 text-lg leading-relaxed">
          I am an MSc researcher and spatial data practitioner focused on converting raw satellite imagery into actionable environmental intelligence. My expertise spans <span class="text-emerald-400 font-medium">Synthetic Aperture Radar (SAR)</span>, <span class="text-cyan-400 font-medium">multispectral image analysis</span>, and scalable python workflows for spatial modeling.
        </p>

        <p class="text-slate-400 leading-relaxed text-sm">
          Whether it’s mapping urban heat islands, processing Copernicus Sentinel archives, or building interactive web maps, I build fast, open-source-driven geospatial solutions without relying on closed black-box software.
        </p>

        <!-- Quick Links -->
        <div class="flex flex-wrap gap-4 pt-2">
          <a 
            href="/cv.pdf" 
            target="_blank"
            class="px-5 py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-semibold text-sm transition flex items-center gap-2 shadow-lg shadow-emerald-500/20"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Download Academic CV
          </a>
          <a 
            href="https://github.com/Ali-Rezaali" 
            target="_blank" 
            class="px-5 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm border border-slate-700 transition flex items-center gap-2"
          >
            GitHub Profile
          </a>
        </div>
      </div>

      <!-- Quick Metrics Card -->
      <div class="lg:col-span-4 bg-slate-900/80 border border-slate-800 rounded-2xl p-6 space-y-6 shadow-xl backdrop-blur-sm">
        <h3 class="text-xs font-mono text-slate-400 uppercase tracking-widest border-b border-slate-800 pb-3">Quick Coordinates</h3>
        
        <div class="space-y-4 font-mono text-xs">
          <div>
            <span class="text-slate-500 block">PRIMARY FIELD</span>
            <span class="text-emerald-400 font-semibold text-sm">Remote Sensing & Geospatial Analytics</span>
          </div>
          <div>
            <span class="text-slate-500 block">SATELLITE DATASETS</span>
            <span class="text-slate-200">Sentinel-1/2, Landsat, MODIS, DEMs</span>
          </div>
          <div>
            <span class="text-slate-500 block">PROGRAMMING</span>
            <span class="text-cyan-400">Python (Primary), SQL, R, JavaScript</span>
          </div>
          <div>
            <span class="text-slate-500 block">SPATIAL REFERENCE</span>
            <span class="text-slate-200">EPSG:4326 (WGS 84) / Universal</span>
          </div>
        </div>
      </div>

    </section>

    <!-- 2. TECHNICAL STACK GRID -->
    <section class="space-y-6">
      <div class="border-b border-slate-800 pb-4">
        <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest">Core Toolkit</span>
        <h2 class="text-2xl font-bold text-white mt-1">Technical Capabilities & Software</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {technicalSkills.map((group) => (
          <div class="p-6 bg-slate-900/60 border border-slate-800/80 rounded-xl hover:border-slate-700 transition">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class={`w-2 h-2 rounded-full ${group.color === 'emerald' ? 'bg-emerald-400' : 'bg-cyan-400'}`}></span>
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="px-3 py-1.5 text-xs font-mono bg-slate-800/80 text-slate-300 border border-slate-700/60 rounded-lg">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. ACADEMIC & RESEARCH TIMELINE -->
    <section class="space-y-6">
      <div class="border-b border-slate-800 pb-4">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest">Experience</span>
        <h2 class="text-2xl font-bold text-white mt-1">Education & Research Timeline</h2>
      </div>

      <div class="relative border-l-2 border-slate-800 ml-4 space-y-8 pl-6">
        {timeline.map((item) => (
          <div class="relative group">
            <!-- Timeline Dot -->
            <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-slate-900 border-2 border-emerald-400 group-hover:scale-125 transition"></div>
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
              <h3 class="text-lg font-bold text-white">{item.title}</h3>
              <span class="text-xs font-mono text-emerald-400 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 w-fit">
                {item.date}
              </span>
            </div>
            
            <span class="text-xs font-mono text-slate-400 block mb-2">{item.institution}</span>
            <p class="text-slate-300 text-sm leading-relaxed max-w-3xl">{item.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. RESEARCH INTERESTS & PHILOSOPHY -->
    <section class="p-8 bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 border border-slate-800 rounded-2xl space-y-4">
      <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest">Methodology</span>
      <h2 class="text-2xl font-bold text-white">Research & Data Philosophy</h2>
      <p class="text-slate-300 text-sm leading-relaxed max-w-3xl">
        Modern Earth Observation is no longer just about generating static map images—it's about processing high-frequency spatial streams into scalable models. I prioritize <span class="text-white font-semibold">reproducible research</span> using open-source tools (Python, GDAL, QGIS) and standard cloud-optimized raster formats (COG, Zarr).
      </p>
    </section>

  </main>
</BaseLayout>