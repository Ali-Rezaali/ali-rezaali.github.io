---
import BaseLayout from '../layouts/BaseLayout.astro';

// Academic / Research Focus Pillars
const researchPillars = [
  {
    title: "SAR & Microwave Remote Sensing",
    icon: "📡",
    description: "Sentinel-1 C-band & L-band SAR time-series analysis, coherence modeling, surface roughness estimation, and polarimetric decomposition for environmental monitoring."
  },
  {
    title: "Physical & Environmental Modeling",
    icon: "🌍",
    description: "Radiative transfer modeling (PROSAIL/DART), Land Surface Temperature (LST) inversion, surface energy balance, and eco-hydrological dynamics across changing biomes."
  },
  {
    title: "Geospatial Deep Learning & Physics-Informed ML",
    icon: "⚡",
    description: "Physics-Informed Neural Networks (PINNs), PyTorch convolutional/transformer architectures for cloud masking, segmentation, and spatio-temporal downscaling."
  },
  {
    title: "Cloud-Native Data Cubes & HPC",
    icon: "💻",
    description: "Processing terabyte-to-petabyte Earth Observation archives using Google Earth Engine, Cloud-Optimized GeoTIFFs (COG), Zarr, and Slurm HPC clusters."
  }
];

// Tech & Modeling Stack
const techStack = [
  { category: "RS & Spatial Libraries", tools: ["GDAL/OGR", "Rasterio", "Xarray", "Riegl / LiDAR", "SNAP / ESA", "PyGMT"] },
  { category: "ML & Numerical Computing", tools: ["PyTorch", "NumPy / SciPy", "Scikit-Learn", "GeoPandas", "Dask", "R / Spatial"] },
  { category: "Physical & RTM Models", tools: ["PROSAIL", "DART", "MODTRAN", "QGIS", "ArcGIS Pro", "SAGA GIS"] },
  { category: "HPC & Infrastructure", tools: ["Linux / Bash", "Slurm Workflows", "Docker", "Google Earth Engine", "Git / GitHub", "PostGIS"] }
];

// Publications & Manuscripts in Prep
const publications = [
  {
    status: "Manuscript in Prep",
    year: "2026",
    title: "High-Resolution Land Surface Temperature Retrieval from Multisource Thermal Satellite Constellations",
    journal: "Remote Sensing of Environment (Target)",
    authors: "Ali Rezaali, et al.",
    doi: "#"
  },
  {
    status: "Conference Paper",
    year: "2025",
    title: "Assessing Sentinel-1 SAR Coherence Loss over Vegetated Terrain during Extreme Drought",
    journal: "IGARSS / Earth Observation Symposium",
    authors: "Ali Rezaali, et al.",
    doi: "#"
  }
];

// Academic Journey
const academicJourney = [
  {
    period: "2024 — Present",
    role: "MSc Candidate in GIS & Remote Sensing",
    institution: "Department of Geoinformatics / Earth Observation Lab",
    details: "Focusing on physical parameter retrieval, microwave remote sensing, and environmental simulation models."
  },
  {
    period: "2020 — 2024",
    role: "BSc in Geomatics / Spatial Science",
    institution: "Faculty of Environmental Sciences",
    details: "Graduated with highest honors. Honors thesis on automated land cover dynamics using dense satellite archives."
  }
];
---

<BaseLayout title="About & Research | Ali Rezaali">
  <main class="max-w-5xl mx-auto px-4 py-10 space-y-20">
    
    <!-- 1. ACADEMIC HERO HEADER -->
    <section class="space-y-6 border-b border-slate-800/80 pb-12">
      <div class="flex flex-wrap items-center gap-3">
        <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-semibold">
          PhD Candidate Track
        </span>
        <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-mono">
          Earth Observation & Env Modeling
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight">
        Ali Rezaali
      </h1>

      <p class="text-xl text-slate-300 leading-relaxed max-w-3xl font-light">
        Geospatial data scientist and Earth Observation researcher bridging physical remote sensing models, synthetic aperture radar (SAR), and machine learning for environmental monitoring.
      </p>

      <!-- Academic Social & Verification Badges -->
      <div class="flex flex-wrap gap-4 pt-4">
        <a 
          href="https://orcid.org" 
          target="_blank" 
          class="px-4 py-2 rounded-lg bg-slate-900 border border-slate-800 hover:border-emerald-500/50 text-slate-300 text-xs font-mono flex items-center gap-2 transition"
        >
          <span class="text-emerald-400 font-bold">ORCID</span> 0000-0000-0000-0000
        </a>
        <a 
          href="https://scholar.google.com" 
          target="_blank" 
          class="px-4 py-2 rounded-lg bg-slate-900 border border-slate-800 hover:border-cyan-500/50 text-slate-300 text-xs font-mono flex items-center gap-2 transition"
        >
          <span class="text-cyan-400 font-bold">Google Scholar</span> Profile
        </a>
        <a 
          href="https://github.com/Ali-Rezaali" 
          target="_blank" 
          class="px-4 py-2 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-600 text-slate-300 text-xs font-mono flex items-center gap-2 transition"
        >
          <span class="text-slate-400 font-bold">GitHub</span> @Ali-Rezaali
        </a>
        <a 
          href="/cv.pdf" 
          target="_blank" 
          class="px-5 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold font-mono transition flex items-center gap-2 shadow-lg shadow-emerald-500/20"
        >
          📄 Download Full Academic CV (PDF)
        </a>
      </div>
    </section>

    <!-- 2. RESEARCH PILLARS -->
    <section class="space-y-8">
      <div>
        <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest">Core Disciplines</span>
        <h2 class="text-3xl font-bold text-white mt-1">Research Focus & Methodology</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {researchPillars.map((pillar) => (
          <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-2xl hover:border-emerald-500/40 transition space-y-3">
            <div class="text-3xl">{pillar.icon}</div>
            <h3 class="text-xl font-bold text-white">{pillar.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{pillar.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. TECHNICAL & MODELING TOOLKIT -->
    <section class="space-y-8">
      <div>
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest">Computational Capabilities</span>
        <h2 class="text-3xl font-bold text-white mt-1">HPC, Remote Sensing & ML Stack</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {techStack.map((group) => (
          <div class="p-6 bg-slate-900/40 border border-slate-800/80 rounded-xl space-y-4">
            <h3 class="text-sm font-mono text-slate-300 font-semibold border-b border-slate-800 pb-2">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.tools.map((tool) => (
                <span class="px-3 py-1.5 text-xs font-mono bg-slate-800/80 text-emerald-300 border border-slate-700/60 rounded-md">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. PUBLICATIONS & WORKING PAPERS -->
    <section class="space-y-8">
      <div>
        <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest">Research Output</span>
        <h2 class="text-3xl font-bold text-white mt-1">Publications & Preprints</h2>
      </div>

      <div class="space-y-4">
        {publications.map((pub) => (
          <div class="p-6 bg-slate-900/80 border border-slate-800 rounded-xl hover:border-slate-700 transition flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-0.5 text-[11px] font-mono rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                  {pub.status}
                </span>
                <span class="text-xs font-mono text-slate-500">{pub.year}</span>
              </div>
              <h3 class="text-lg font-bold text-white">{pub.title}</h3>
              <p class="text-xs font-mono text-slate-400">{pub.authors} — <span class="italic text-slate-300">{pub.journal}</span></p>
            </div>
            <a href={pub.doi} class="px-4 py-2 text-xs font-mono bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-lg text-center transition whitespace-nowrap">
              DOI / Manuscript →
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. ACADEMIC & RESEARCH HISTORY -->
    <section class="space-y-8">
      <div>
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest">Background</span>
        <h2 class="text-3xl font-bold text-white mt-1">Education & Positions</h2>
      </div>

      <div class="relative border-l-2 border-slate-800 ml-3 space-y-10 pl-6">
        {academicJourney.map((item) => (
          <div class="relative group">
            <div class="absolute -left-[31px] top-1.5 w-3 h-3 rounded-full bg-slate-950 border-2 border-emerald-400"></div>
            <span class="text-xs font-mono text-emerald-400 block mb-1">{item.period}</span>
            <h3 class="text-xl font-bold text-white">{item.role}</h3>
            <span class="text-xs font-mono text-slate-400 block mb-2">{item.institution}</span>
            <p class="text-slate-300 text-sm max-w-2xl leading-relaxed">{item.details}</p>
          </div>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>