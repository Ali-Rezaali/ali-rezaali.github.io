---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobeWidget from '../components/GlobeWidget.astro';
const featuredProjects = [
  {
    title: "SAR Time-Series Deframe & Filtering",
    tech: ["Sentinel-1", "Python", "SNAP"],
    description: "Speckle noise reduction and coherence analysis for land deformation tracking using Sentinel-1 C-band SAR.",
    link: "/projects/sar-analysis"
  },
  {
    title: "Urban Heat Island Surface Temp",
    tech: ["Landsat 8/9", "Google Earth Engine"],
    description: "Automated extraction of Land Surface Temperature (LST) and correlation with NDVI across urban centers.",
    link: "/projects/urban-heat"
  },
  {
    title: "Dynamic Land Cover Classification",
    tech: ["Sentinel-2", "PyTorch", "Random Forest"],
    description: "Deep learning pixel-wise classification of multispectral imagery to detect deforestation dynamics.",
    link: "/projects/land-cover"
  }
];
---

<BaseLayout title="Ali Rezaali | GIS & Remote Sensing">
  <main class="max-w-5xl mx-auto px-4 py-8 space-y-16">


    <!-- HERO SECTION -->
    <section class="space-y-6 pt-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>MSc GIS & Remote Sensing Specialist</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
        Geospatial Data Science & Remote Sensing
      </h1>

      <p class="text-slate-300 text-lg sm:text-xl max-w-3xl leading-relaxed">
        Specializing in SAR time-series analysis, land cover classification, deep learning on satellite imagery, and open-source geospatial web applications.
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <a 
          href="/projects" 
          class="px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm transition shadow-lg shadow-emerald-500/20"
        >
          Explore Projects →
        </a>
        <a 
          href="/about" 
          class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-semibold text-sm border border-slate-800 transition"
        >
          About & Experience
        </a>
      </div>
    </section>

  <GlobeWidget />


    <!-- TOP HERO IMAGE WITH GRADIENT MASK -->
<div class="relative w-full h-[40px] sm:h-[520px] overflow-hidden rounded-3xl mb-10 border border-slate-800/50">
  <img 
    src="https://images.unsplash.com/photo-1614728894747-a83421e2b9c9?q=80&w=1600&200=format&fit=crop" 
    alt="Earth Observation Remote Sensing" 
    class="w-full h-full object-cover object-center"
    style="-webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 15%, rgba(0,0,0,0) 100%); mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);"
  />
</div>
    <!-- GLOBE & DATASETS WIDGET -->

    <!-- FEATURED PROJECTS GRID -->
    <section class="space-y-6">
      <div class="flex justify-between items-end border-b border-slate-800 pb-4">
        <div>
          <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest">Portfolio Highlight</span>
          <h2 class="text-2xl font-bold text-white mt-1">Featured Projects</h2>
        </div>
        <a href="/projects" class="text-xs font-mono text-slate-400 hover:text-emerald-400 transition">View All →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredProjects.map((project) => (
          <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-xl hover:border-emerald-500/50 transition group flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex flex-wrap gap-1.5">
                {project.tech.map((t) => (
                  <span class="px-2 py-0.5 text-[10px] font-mono bg-slate-800 text-emerald-400 rounded border border-slate-700">
                    {t}
                  </span>
                ))}
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-emerald-400 transition">{project.title}</h3>
              <p class="text-slate-400 text-xs leading-relaxed">{project.description}</p>
            </div>
            <a href={project.link} class="inline-block mt-4 text-xs font-mono text-emerald-400 group-hover:translate-x-1 transition">
              Read Research →
            </a>
          </div>
        ))}
      </div>
    </section>

  </main>
</BaseLayout>